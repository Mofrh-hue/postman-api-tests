    {
      "name": "Auth (negative)",
      "item": [
        {
          "name": "Login with a wrong password is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('No access token is returned', () => pm.expect(body).to.not.have.property('access_token'));",
                  "pm.test('Error says Unauthorized', () => pm.expect(body.error).to.eql('Unauthorized'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
