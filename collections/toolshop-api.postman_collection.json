        {
          "name": "Login with an empty body is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('No access token is returned', () => pm.expect(body).to.not.have.property('access_token'));",
                  "pm.test('An error message is returned', () => pm.expect(body.error).to.be.a('string').and.not.empty);"
                ]
              }
            }
