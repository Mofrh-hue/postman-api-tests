{
  "info": {
    "_postman_id": "84ed0521-8e13-5e5e-bb5b-79a710ccf7f0",
    "name": "Toolshop API",
    "description": "API tests for the Toolshop practice web shop (https://practicesoftwaretesting.com). Covers products, pagination, sorting, filtering, categories, brands, search and negative login checks. Requests are chained: ids saved by one request are used by the next.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "List products (page 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "const productSchema = {",
                  "    type: 'object',",
                  "    required: ['id', 'name', 'price', 'in_stock', 'category', 'brand', 'product_image'],",
                  "    properties: {",
                  "        id: { type: 'string', minLength: 1 },",
                  "        name: { type: 'string', minLength: 1 },",
                  "        price: { type: 'number', exclusiveMinimum: 0 },",
                  "        in_stock: { type: 'boolean' },",
                  "        co2_rating: { type: 'string', pattern: '^[A-E]$' },",
                  "        category: { type: 'object', required: ['id', 'name', 'slug'] },",
                  "        brand: { type: 'object', required: ['id', 'name'] },",
                  "        product_image: { type: 'object', required: ['file_name'] }",
                  "    }",
                  "};",
                  "",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Response is paginated', () => {",
                  "    pm.expect(body).to.include.keys('current_page', 'data', 'per_page', 'last_page', 'total');",
                  "    pm.expect(body.current_page).to.eql(1);",
                  "    pm.expect(body.data.length).to.be.above(0).and.at.most(body.per_page);",
                  "    pm.expect(body.total).to.be.at.least(body.data.length);",
                  "});",
                  "",
                  "pm.test('Every product matches the product schema', () => {",
                  "    pm.response.to.have.jsonSchema({ type: 'object', properties: { data: { type: 'array', items: productSchema } } });",
                  "});",
                  "",
                  "pm.test('Product ids are unique on the page', () => {",
                  "    const ids = body.data.map(p => p.id);",
                  "    pm.expect(new Set(ids).size).to.eql(ids.length);",
                  "});",
                  "",
                  "// Save values for the requests that follow",
                  "const first = body.data[0];",
                  "pm.collectionVariables.set('productId', first.id);",
                  "pm.collectionVariables.set('productName', first.name);",
                  "pm.collectionVariables.set('productPrice', first.price);",
                  "pm.collectionVariables.set('lastPage', body.last_page);",
                  "pm.collectionVariables.set('perPage', body.per_page);",
                  "pm.collectionVariables.set('totalProducts', body.total);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Lists the first page of products and saves the first product, page size and total for later requests."
          }
        },
        {
          "name": "Get product by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Returns the product that was requested', () => {",
                  "    pm.expect(body.id).to.eql(pm.collectionVariables.get('productId'));",
                  "});",
                  "",
                  "pm.test('Name and price match the product list', () => {",
                  "    pm.expect(body.name).to.eql(pm.collectionVariables.get('productName'));",
                  "    pm.expect(body.price).to.eql(Number(pm.collectionVariables.get('productPrice')));",
                  "});",
                  "",
                  "pm.test('Specifications have a name and a value', () => {",
                  "    pm.expect(body.specs).to.be.an('array').that.is.not.empty;",
                  "    body.specs.forEach(s => {",
                  "        pm.expect(s.spec_name, 'spec_name').to.be.a('string').and.not.empty;",
                  "        pm.expect(s.spec_value, 'spec_value').to.be.a('string').and.not.empty;",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            },
            "description": "Uses the product id saved by the previous request (request chaining)."
          }
        },
