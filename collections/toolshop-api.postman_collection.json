        {
          "name": "Last page has the remaining products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const total = Number(pm.collectionVariables.get('totalProducts'));",
                  "const perPage = Number(pm.collectionVariables.get('perPage'));",
                  "const lastPage = Number(pm.collectionVariables.get('lastPage'));",
                  "",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Item count on the last page adds up to the total', () => {",
                  "    pm.expect(body.current_page).to.eql(lastPage);",
                  "    pm.expect(body.data.length).to.eql(total - (lastPage - 1) * perPage);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?page={{lastPage}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "{{lastPage}}"
                }
              ]
            },
            "description": "Checks the pagination maths: items on the last page = total - (last_page - 1) * per_page."
          }
