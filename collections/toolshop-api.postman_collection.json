                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Top-level categories have no parent', () => {",
                  "    pm.expect(body).to.not.be.empty;",
                  "    body.forEach(c => pm.expect(c.parent_id, c.name).to.be.null);",
                  "});",
                  "",
                  "pm.test('Sub-categories point back to their parent', () => {",
                  "    body.forEach(parent => (parent.sub_categories || []).forEach(child => {",
                  "        pm.expect(child.parent_id, child.name).to.eql(parent.id);",
                  "    }));",
                  "});"
