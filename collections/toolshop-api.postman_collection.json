          "name": "List categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Every category has an id, name and slug', () => {",
                  "    pm.response.to.have.jsonSchema({",
                  "        type: 'array', minItems: 1,",
                  "        items: { type: 'object', required: ['id', 'name', 'slug'] }",
                  "    });",
                  "});",
                  "",
                  "pm.test('Every parent_id points to an existing category', () => {",
                  "    const ids = new Set(body.map(c => c.id));",
                  "    body.filter(c => c.parent_id).forEach(c => pm.expect(ids.has(c.parent_id), c.name).to.be.true);",
                  "});",
                  "",
                  "const pliers = body.find(c => c.slug === 'pliers');",
                  "pm.test('\"Pliers\" category exists', () => pm.expect(pliers).to.be.an('object'));",
                  "if (pliers) pm.collectionVariables.set('pliersCategoryId', pliers.id);"
                ]
              }
            }
